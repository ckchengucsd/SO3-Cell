SITE coresite
    SIZE 0.0450 BY 0.1440 ;
    CLASS CORE ;
    SYMMETRY X Y ;
END coresite

SITE coresite_DH_N
    SIZE 0.0450 BY 0.2880 ;
    CLASS CORE ;
    SYMMETRY X Y ;
END coresite_DH_N

MACRO PREFIXADD_X1
  CLASS CORE ;
  ORIGIN 0 0 ;
  FOREIGN PREFIXADD_X1 0 0 ;
  SIZE 0.405000 BY 0.144000 ;
  SYMMETRY X Y ;
  SITE coresite ;
  PIN G1
    DIRECTION INPUT ;
    USE SIGNAL ;
    PORT
      LAYER M0 ;
        RECT 0.067500 0.053000 0.102000 0.067000 ;
    END
  END G1
  PIN P1
    DIRECTION INPUT ;
    USE SIGNAL ;
    PORT
      LAYER M0 ;
        RECT 0.168000 0.029000 0.282000 0.043000 ;
    END
  END P1
  PIN G0
    DIRECTION INPUT ;
