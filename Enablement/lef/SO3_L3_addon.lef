  END G0
  PIN P0
    DIRECTION INPUT ;
    USE SIGNAL ;
    PORT
      LAYER M0 ;
        RECT 0.292500 0.077000 0.327000 0.091000 ;
    END
  END P0
  PIN VDD
    DIRECTION INOUT ;
    USE POWER ;
    SHAPE ABUTMENT ;
    PORT
      LAYER M0 ;
        RECT 0.000000 0.126000 0.405000 0.162000 ;
    END
  END VDD
  PIN VSS
    DIRECTION INOUT ;
    USE GROUND ;
    SHAPE ABUTMENT ;
    PORT
      LAYER M0 ;
        RECT 0.000000 -0.018000 0.405000 0.018000 ;
    END
  END VSS
  PIN G_OUT
    DIRECTION OUTPUT ;
    USE SIGNAL ;
    PORT
      LAYER M0 ;
        RECT 0.010500 0.101000 0.045000 0.115000 ;
    END
  END G_OUT
  PIN P_OUT
    DIRECTION OUTPUT ;
    USE SIGNAL ;
    PORT
      LAYER M0 ;
        RECT 0.360000 0.029000 0.394500 0.043000 ;
    END
  END P_OUT
  OBS
      LAYER M0 ;
        RECT 0.033000 0.029000 0.124500 0.043000 ;
        RECT 0.235500 0.053000 0.372000 0.067000 ;
        RECT 0.033000 0.077000 0.169500 0.091000 ;
        RECT 0.100500 0.101000 0.214500 0.115000 ;
        RECT 0.280500 0.101000 0.372000 0.115000 ;
  END
END PREFIXADD_X1

